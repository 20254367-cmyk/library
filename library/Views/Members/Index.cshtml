@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Members</h1>
        <p>@Model.Count registered members</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary">＋ Add member</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">👥</div>
        <h3 class="empty-state-title">No members yet</h3>
        <p class="empty-state-text">Register a new member to get started.</p>
        <a asp-action="Create" class="btn btn-primary">Add member</a>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th class="text-end">Books out</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td class="fw-600">@member.FullName</td>
                        <td class="text-muted">@(member.Email ?? "—")</td>
                        <td><span class="badge badge-brand">@member.MemberType</span></td>
                        <td class="text-end">
                            @if (member.OpenLoans == 0)
                            {
                                <span class="text-muted">0</span>
                            }
                            else
                            {
                                <span class="fw-700" style="color:var(--warning-600);">@member.OpenLoans</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-secondary">Loans</a>
                            <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}