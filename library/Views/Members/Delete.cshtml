@model Member
@{
    ViewData["Title"] = "Delete Member";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Delete Member</h1>
        <p>This action cannot be undone</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary">← Back</a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <span class="alert-icon">⚠</span>
        <div>
            <p class="alert-title">Cannot delete member</p>
            <div>@ViewBag.Error</div>
        </div>
    </div>
}

<div class="danger-zone">
    <div class="danger-zone-header">
        <div class="danger-zone-icon">⚠</div>
        <h3 class="danger-zone-title">Are you sure you want to delete this member?</h3>
    </div>
    <div class="danger-zone-body">
        <dl class="detail-list">
            <dt>Full Name</dt>
            <dd>@Model.FullName</dd>
            <dt>Email</dt>
            <dd>@(Model.Email ?? "—")</dd>
            <dt>Member Type</dt>
            <dd>@Model.MemberType</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="MemberId" />
            <div class="form-actions" style="border:none;padding:0;margin:0;">
                <button type="submit" class="btn btn-danger">Delete Member</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>