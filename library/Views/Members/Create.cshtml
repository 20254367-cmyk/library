@model Member
@{
    ViewData["Title"] = "Add Member";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Add Member</h1>
        <p>Register a new library member</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary">← Back</a>
    </div>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" class="form-card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="FullName" class="form-label">Full Name <span class="req">*</span></label>
            <input asp-for="FullName" class="form-control" placeholder="Lastname, Firstname" />
            <span asp-validation-for="FullName" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="ana@ubaguio.edu" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="MemberType" class="form-label">Member Type <span class="req">*</span></label>
            <input asp-for="MemberType" class="form-control" placeholder="Student / Faculty" />
            <span asp-validation-for="MemberType" class="form-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Member</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}